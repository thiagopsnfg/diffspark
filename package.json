{
  "name": "diffspark",
  "displayName": "DiffSpark",
  "description": "Smarter reviews. Better code. Review Bitbucket Cloud pull requests from VS Code.",
  "version": "0.1.1",
  "publisher": "thiagopsnfg",
  "repository": {
    "type": "git",
    "url": "https://github.com/thiagopsnfg/diffspark.git"
  },
  "bugs": {
    "url": "https://github.com/thiagopsnfg/diffspark/issues"
  },
  "icon": "resources/diffspark-icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "AI"
  ],
  "keywords": [
    "review",
    "bitbucket",
    "pull request"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "title": "DiffSpark",
          "id": "bitbucketPrReviewer",
          "icon": "resources/diffspark-icon.svg"
        }
      ]
    },
    "views": {
      "bitbucketPrReviewer": [
        {
          "name": "Pull Requests",
          "icon": "resources/diffspark-icon.svg",
          "id": "bitbucketPrReviewer.pullRequests"
        }
      ]
    },
    "commands": [
      {
        "title": "DiffSpark: Connect",
        "command": "bitbucketPrReviewer.connect",
        "icon": "$(plug)"
      },
      {
        "title": "DiffSpark: Connect Jira",
        "command": "bitbucketPrReviewer.connectJira",
        "icon": "$(plug)"
      },
      {
        "title": "DiffSpark: Refresh",
        "command": "bitbucketPrReviewer.refresh",
        "icon": "$(refresh)"
      },
      {
        "title": "DiffSpark: Select Repository",
        "command": "bitbucketPrReviewer.selectRepository",
        "icon": "$(repo)"
      },
      {
        "title": "DiffSpark: Filter Pull Requests",
        "command": "bitbucketPrReviewer.filterPullRequests",
        "icon": "$(filter)"
      },
      {
        "title": "DiffSpark: Filter Pull Requests by Author",
        "command": "bitbucketPrReviewer.filterByAuthor",
        "icon": "$(person)"
      },
      {
        "title": "DiffSpark: Sort Pull Requests",
        "command": "bitbucketPrReviewer.sortPullRequests",
        "icon": "$(sort-precedence)"
      },
      {
        "title": "DiffSpark: Select File Layout",
        "command": "bitbucketPrReviewer.selectFileLayout",
        "icon": "$(list-tree)"
      },
      {
        "title": "DiffSpark: Open Pull Request",
        "command": "bitbucketPrReviewer.openPullRequest",
        "icon": "$(git-pull-request)"
      },
      {
        "title": "Abrir arquivo",
        "command": "bitbucketPrReviewer.openWorkspaceFile",
        "icon": "$(go-to-file)"
      },
      {
        "title": "Abrir arquivo no destino",
        "command": "bitbucketPrReviewer.openFileOnPrBranch",
        "icon": "$(git-branch)"
      },
      {
        "title": "Comment",
        "command": "bitbucketPrReviewer.createDiffComment"
      },
      {
        "title": "Reply",
        "command": "bitbucketPrReviewer.replyDiffComment"
      },
      {
        "title": "Delete comment",
        "command": "bitbucketPrReviewer.deleteDiffComment",
        "icon": "$(trash)"
      },
      {
        "title": "Improve comment",
        "command": "bitbucketPrReviewer.improveDiffComment",
        "icon": "$(wand)"
      },
      {
        "title": "AI actions ▾",
        "command": "bitbucketPrReviewer.improveDiffCommentWith",
        "icon": "$(chevron-down)"
      },
      {
        "title": "Replace & post",
        "command": "bitbucketPrReviewer.aiSuggestionReplace"
      },
      {
        "title": "Insert below",
        "command": "bitbucketPrReviewer.aiSuggestionInsert"
      },
      {
        "title": "Try again",
        "command": "bitbucketPrReviewer.aiSuggestionRetry"
      },
      {
        "title": "Discard",
        "command": "bitbucketPrReviewer.aiSuggestionDiscard"
      },
      {
        "title": "Post comment",
        "command": "bitbucketPrReviewer.aiDraftPost"
      },
      {
        "title": "Improve comment",
        "command": "bitbucketPrReviewer.aiDraftImprove",
        "icon": "$(wand)"
      },
      {
        "title": "AI actions ▾",
        "command": "bitbucketPrReviewer.aiDraftImproveWith",
        "icon": "$(chevron-down)"
      },
      {
        "title": "Delete draft",
        "command": "bitbucketPrReviewer.aiDraftDelete"
      },
      {
        "title": "DiffSpark: Select AI Provider",
        "command": "bitbucketPrReviewer.selectAiProvider",
        "icon": "$(wand)"
      },
      {
        "title": "DiffSpark: Set AI API Key",
        "command": "bitbucketPrReviewer.setAiApiKey",
        "icon": "$(key)"
      },
      {
        "title": "DiffSpark: Review Pull Request with AI",
        "command": "bitbucketPrReviewer.reviewWithAi",
        "icon": "$(sparkle)"
      },
      {
        "title": "DiffSpark: Edit AI Review Rules",
        "command": "bitbucketPrReviewer.editReviewRules",
        "icon": "$(book)"
      }
    ],
    "configuration": {
      "title": "DiffSpark",
      "properties": {
        "diffspark.files.layout": {
          "type": "string",
          "enum": [
            "tree",
            "list"
          ],
          "enumDescriptions": [
            "Nest changed files in their repository folders.",
            "Show changed files in a flat list with their folder paths as text."
          ],
          "default": "tree",
          "description": "Layout of changed files under each pull request."
        },
        "diffspark.ai.provider": {
          "type": "string",
          "enum": [
            "copilot",
            "openai",
            "gemini"
          ],
          "enumDescriptions": [
            "GitHub Copilot through the VS Code Language Model API (no API key needed).",
            "OpenAI (or an OpenAI-compatible endpoint) using an API key.",
            "Google Gemini using an API key."
          ],
          "default": "copilot",
          "markdownDescription": "AI provider used by **Improve comment** and **Review with AI**. API keys are set with the `DiffSpark: Set AI API Key` command and stored in VS Code's secret storage."
        },
        "diffspark.ai.model": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional model for **Improve comment** and **Review with AI**. Copilot: a model family such as `gpt-4.1`. OpenAI default: `gpt-4o-mini`. Gemini default: `gemini-2.5-flash`."
        },
        "diffspark.ai.openaiBaseUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "markdownDescription": "Base URL for the OpenAI provider. Change it to use an OpenAI-compatible endpoint (for example Azure OpenAI, OpenRouter or a local server)."
        },
        "diffspark.ai.review.language": {
          "type": "string",
          "default": "",
          "markdownDescription": "Language of the **Review with AI** summary and comments, e.g. `Portuguese (Brazil)` or `English`. Leave empty to use the VS Code display language."
        },
        "diffspark.ai.review.minSeverity": {
          "type": "string",
          "enum": [
            "nit",
            "minor",
            "major",
            "blocker"
          ],
          "enumDescriptions": [
            "Show everything, including small optional improvements.",
            "Hide nitpicks.",
            "Only likely bugs, wrong behaviour and important rule violations.",
            "Only problems that must block the merge."
          ],
          "default": "minor",
          "markdownDescription": "Lowest severity of the **Review with AI** findings to show."
        },
        "diffspark.ai.review.minConfidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.5,
          "markdownDescription": "Hide **Review with AI** findings the AI is less confident about (0–1)."
        },
        "diffspark.ai.review.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra glob patterns of files that **Review with AI** must skip, e.g. `**/generated/**`. Lockfiles, `dist/`, minified files, source maps, snapshots and binaries are always skipped."
        },
        "diffspark.ai.review.focus": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "security",
              "performance",
              "tests",
              "readability",
              "design"
            ]
          },
          "uniqueItems": true,
          "default": [],
          "markdownDescription": "Areas **Review with AI** should pay extra attention to. Bugs are always checked."
        },
        "diffspark.ai.review.useRepositoryInstructions": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Use the repository instructions found in the local clone (`AGENTS.md`, `.github/copilot-instructions.md` and `.github/instructions/**/*.instructions.md` with `applyTo`) as review rules, together with your global rules (`DiffSpark: Edit AI Review Rules`)."
        },
        "diffspark.ai.review.maxFiles": {
          "type": "integer",
          "minimum": 1,
          "default": 60,
          "markdownDescription": "Ask for confirmation before reviewing pull requests with more reviewable files than this."
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "bitbucketPrReviewer.deleteDiffComment",
          "when": "false"
        },
        {
          "command": "bitbucketPrReviewer.improveDiffComment",
          "when": "false"
        },
        {
          "command": "bitbucketPrReviewer.improveDiffCommentWith",
          "when": "false"
        },
        {
          "command": "bitbucketPrReviewer.aiSuggestionReplace",
          "when": "false"
        },
        {
          "command": "bitbucketPrReviewer.aiSuggestionInsert",
          "when": "false"
        },
        {
          "command": "bitbucketPrReviewer.aiSuggestionRetry",
          "when": "false"
        },
        {
          "command": "bitbucketPrReviewer.aiSuggestionDiscard",
          "when": "false"
        },
        {
          "command": "bitbucketPrReviewer.aiDraftPost",
          "when": "false"
        },
        {
          "command": "bitbucketPrReviewer.aiDraftImprove",
          "when": "false"
        },
        {
          "command": "bitbucketPrReviewer.aiDraftImproveWith",
          "when": "false"
        },
        {
          "command": "bitbucketPrReviewer.aiDraftDelete",
          "when": "false"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "bitbucketPrReviewer.createDiffComment",
          "group": "inline@1",
          "when": "commentController == diffspark && commentThreadIsEmpty"
        },
        {
          "command": "bitbucketPrReviewer.replyDiffComment",
          "group": "inline@1",
          "when": "commentController == diffspark && !commentThreadIsEmpty"
        },
        {
          "command": "bitbucketPrReviewer.improveDiffComment",
          "group": "inline@2",
          "when": "commentController == diffspark"
        },
        {
          "command": "bitbucketPrReviewer.improveDiffCommentWith",
          "group": "inline@3",
          "when": "commentController == diffspark"
        }
      ],
      "comments/comment/title": [
        {
          "command": "bitbucketPrReviewer.deleteDiffComment",
          "group": "inline@1",
          "when": "commentController == diffspark && comment == diffsparkOwnComment"
        }
      ],
      "comments/comment/context": [
        {
          "command": "bitbucketPrReviewer.aiSuggestionReplace",
          "group": "inline@1",
          "when": "commentController == diffspark && comment == diffsparkAiSuggestion"
        },
        {
          "command": "bitbucketPrReviewer.aiSuggestionInsert",
          "group": "inline@2",
          "when": "commentController == diffspark && comment == diffsparkAiSuggestion"
        },
        {
          "command": "bitbucketPrReviewer.aiSuggestionRetry",
          "group": "inline@3",
          "when": "commentController == diffspark && comment == diffsparkAiSuggestion"
        },
        {
          "command": "bitbucketPrReviewer.aiSuggestionDiscard",
          "group": "inline@4",
          "when": "commentController == diffspark && comment == diffsparkAiSuggestion"
        },
        {
          "command": "bitbucketPrReviewer.aiDraftPost",
          "group": "inline@1",
          "when": "commentController == diffspark && comment == diffsparkAiDraft"
        },
        {
          "command": "bitbucketPrReviewer.aiDraftImprove",
          "group": "inline@2",
          "when": "commentController == diffspark && comment == diffsparkAiDraft"
        },
        {
          "command": "bitbucketPrReviewer.aiDraftImproveWith",
          "group": "inline@3",
          "when": "commentController == diffspark && comment == diffsparkAiDraft"
        },
        {
          "command": "bitbucketPrReviewer.aiDraftDelete",
          "group": "inline@4",
          "when": "commentController == diffspark && comment == diffsparkAiDraft"
        }
      ],
      "editor/title": [
        {
          "command": "bitbucketPrReviewer.openWorkspaceFile",
          "group": "navigation@1",
          "when": "isInDiffEditor && resourceScheme == diffspark"
        },
        {
          "command": "bitbucketPrReviewer.openFileOnPrBranch",
          "group": "navigation@2",
          "when": "isInDiffEditor && resourceScheme == diffspark"
        }
      ],
      "view/title": [
        {
          "group": "navigation",
          "command": "bitbucketPrReviewer.selectFileLayout",
          "when": "view == bitbucketPrReviewer.pullRequests"
        },
        {
          "group": "navigation",
          "command": "bitbucketPrReviewer.refresh",
          "when": "view == bitbucketPrReviewer.pullRequests"
        },
        {
          "group": "navigation",
          "when": "view == bitbucketPrReviewer.pullRequests",
          "command": "bitbucketPrReviewer.filterPullRequests"
        },
        {
          "group": "navigation",
          "command": "bitbucketPrReviewer.filterByAuthor",
          "when": "view == bitbucketPrReviewer.pullRequests"
        },
        {
          "group": "navigation",
          "command": "bitbucketPrReviewer.sortPullRequests",
          "when": "view == bitbucketPrReviewer.pullRequests"
        },
        {
          "group": "navigation",
          "command": "bitbucketPrReviewer.selectRepository",
          "when": "view == bitbucketPrReviewer.pullRequests"
        }
      ],
      "view/item/context": [
        {
          "command": "bitbucketPrReviewer.reviewWithAi",
          "when": "view == bitbucketPrReviewer.pullRequests && viewItem == bitbucketPullRequest",
          "group": "inline"
        },
        {
          "command": "bitbucketPrReviewer.reviewWithAi",
          "when": "view == bitbucketPrReviewer.pullRequests && viewItem == bitbucketPullRequest",
          "group": "ai@1"
        },
        {
          "command": "bitbucketPrReviewer.editReviewRules",
          "when": "view == bitbucketPrReviewer.pullRequests && viewItem == bitbucketPullRequest",
          "group": "ai@2"
        }
      ]
    }
  },
  "scripts": {
    "prepare": "husky",
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "lint": "biome lint .",
    "lint-staged": "lint-staged",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "npm run compile && node --test test/*.test.js",
    "test:coverage": "npm run compile && c8 --include='dist/bitbucket/**/*.js' --include='dist/views/markdown.js' --reporter=text --reporter=lcov node --test test/*.test.js",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "diff": "^8.0.4",
    "markdown-it": "^14.1.0",
    "minimatch": "^10.2.6",
    "sanitize-html": "^2.14.0"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "@biomejs/biome": "2.5.14",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.19.43",
    "@types/sanitize-html": "^2.13.0",
    "@types/vscode": "^1.90.0",
    "c8": "^10.1.3",
    "typescript": "^5.7.2"
  }
}
