{
  "name": "diffspark",
  "displayName": "DiffSpark",
  "description": "Smarter reviews. Better code. Review Bitbucket Cloud pull requests from VS Code.",
  "version": "0.1.0",
  "publisher": "thiagopsnfg",
  "repository": {
    "type": "git",
    "url": "https://github.com/thiagopsnfg/diffspark.git"
  },
  "icon": "resources/diffspark-icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Source Control"
  ],
  "keywords": [
    "review",
    "bitbucket",
    "pull request"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "title": "DiffSpark",
          "id": "bitbucketPrReviewer",
          "icon": "resources/diffspark-icon.svg"
        }
      ]
    },
    "views": {
      "bitbucketPrReviewer": [
        {
          "name": "Pull Requests",
          "icon": "resources/diffspark-icon.svg",
          "id": "bitbucketPrReviewer.pullRequests"
        }
      ]
    },
    "commands": [
      {
        "title": "DiffSpark: Connect",
        "command": "bitbucketPrReviewer.connect",
        "icon": "$(plug)"
      },
      {
        "title": "DiffSpark: Connect Jira",
        "command": "bitbucketPrReviewer.connectJira",
        "icon": "$(plug)"
      },
      {
        "title": "DiffSpark: Refresh",
        "command": "bitbucketPrReviewer.refresh",
        "icon": "$(refresh)"
      },
      {
        "title": "DiffSpark: Select Repository",
        "command": "bitbucketPrReviewer.selectRepository",
        "icon": "$(repo)"
      },
      {
        "title": "DiffSpark: Filter Pull Requests",
        "command": "bitbucketPrReviewer.filterPullRequests",
        "icon": "$(filter)"
      },
      {
        "title": "DiffSpark: Filter Pull Requests by Author",
        "command": "bitbucketPrReviewer.filterByAuthor",
        "icon": "$(person)"
      },
      {
        "title": "DiffSpark: Sort Pull Requests",
        "command": "bitbucketPrReviewer.sortPullRequests",
        "icon": "$(sort-precedence)"
      },
      {
        "title": "DiffSpark: Open Pull Request",
        "command": "bitbucketPrReviewer.openPullRequest",
        "icon": "$(git-pull-request)"
      },
      {
        "title": "Abrir arquivo",
        "command": "bitbucketPrReviewer.openWorkspaceFile",
        "icon": "$(go-to-file)"
      },
      {
        "title": "Abrir arquivo no destino",
        "command": "bitbucketPrReviewer.openFileOnPrBranch",
        "icon": "$(git-branch)"
      },
      {
        "title": "Comment",
        "command": "bitbucketPrReviewer.createDiffComment"
      },
      {
        "title": "Reply",
        "command": "bitbucketPrReviewer.replyDiffComment"
      }
    ],
    "menus": {
      "comments/commentThread/context": [
        {
          "command": "bitbucketPrReviewer.createDiffComment",
          "group": "inline",
          "when": "commentController == diffspark && commentThreadIsEmpty"
        },
        {
          "command": "bitbucketPrReviewer.replyDiffComment",
          "group": "inline",
          "when": "commentController == diffspark && !commentThreadIsEmpty"
        }
      ],
      "editor/title": [
        {
          "command": "bitbucketPrReviewer.openWorkspaceFile",
          "group": "navigation@1",
          "when": "isInDiffEditor && resourceScheme == diffspark"
        },
        {
          "command": "bitbucketPrReviewer.openFileOnPrBranch",
          "group": "navigation@2",
          "when": "isInDiffEditor && resourceScheme == diffspark"
        }
      ],
      "view/title": [
        {
          "group": "navigation",
          "command": "bitbucketPrReviewer.refresh",
          "when": "view == bitbucketPrReviewer.pullRequests"
        },
        {
          "group": "navigation",
          "when": "view == bitbucketPrReviewer.pullRequests",
          "command": "bitbucketPrReviewer.filterPullRequests"
        },
        {
          "group": "navigation",
          "command": "bitbucketPrReviewer.filterByAuthor",
          "when": "view == bitbucketPrReviewer.pullRequests"
        },
        {
          "group": "navigation",
          "command": "bitbucketPrReviewer.sortPullRequests",
          "when": "view == bitbucketPrReviewer.pullRequests"
        },
        {
          "group": "navigation",
          "command": "bitbucketPrReviewer.selectRepository",
          "when": "view == bitbucketPrReviewer.pullRequests"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "npm run compile && node --test test/*.test.js",
    "test:coverage": "npm run compile && c8 --include='dist/bitbucket/**/*.js' --include='dist/views/markdown.js' --reporter=text --reporter=lcov node --test test/*.test.js",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "markdown-it": "^14.1.0",
    "sanitize-html": "^2.14.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.19.43",
    "@types/sanitize-html": "^2.13.0",
    "@types/vscode": "^1.90.0",
    "c8": "^10.1.3",
    "typescript": "^5.7.2"
  }
}
